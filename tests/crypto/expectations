# Listed only because the BerEncodedSignature lines above would otherwise claim it.
ecdsa_secp256r1_sha256_test.json tc=48 reject indefinite length refused (asn1parse.c:40), as Wycheproof wants
ecdsa_secp256r1_sha512_test.json tc=48 reject indefinite length refused (asn1parse.c:40), as Wycheproof wants
