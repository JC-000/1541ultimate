# The ESP-IDF 6 / mbedTLS 4 pin set (contract C4), which run_idf6.sh passes as CRYPTO_PINS; PINS
# is the 3.6 path. The sdkconfig that goes with it is sdkconfig.v6.0.3 (regen_sdkconfig.sh).
# Otherwise as PINS: the one place the crypto conformance suite (tests/crypto/run.sh) and its
# build helper (build_mbedtls.sh) take their sources from. Moving to a new ESP-IDF / mbedTLS release is a
# change to this file (and the ESP-IDF image the firmware builds with, sdkconfig included), and
# nothing else.
# Fetched sources are pinned by full 40-character commit SHA, never by branch or tag.

# ESP-IDF release the ESP32 image builds with, and the commit the tag must name; its
# components/mbedtls/port/include/mbedtls/esp_config.h turns software/wifi/raw_u64/sdkconfig
# into the mbedTLS configuration.
ESP_IDF_TAG=v6.0.3
ESP_IDF_COMMIT=76f5dedd9950a3012fee8fb7d5586df21fc67802
# The mbedtls submodule of ESP-IDF at ESP_IDF_TAG (mbedTLS 4.1.1 with TF-PSA-Crypto vendored, with
# Espressif's changes).
MBEDTLS_REPO=https://github.com/espressif/mbedtls
MBEDTLS_COMMIT=ce3f3485a121c100f58f36d700cb35b060f6e866
# Independent test vectors (Project Wycheproof, testvectors_v1/).
WYCHEPROOF_REPO=https://github.com/C2SP/wycheproof
WYCHEPROOF_COMMIT=3fa63dd0344abb611f1fb1d77e119938603ea230
# X.509 path validation test cases (limbo.json).
X509_LIMBO_REPO=https://github.com/C2SP/x509-limbo
X509_LIMBO_COMMIT=554528a9b0c0d95e071f55de018326f0b65a8364
