# Used only when sdkconfig is regenerated (idf.py set-target, or a deleted sdkconfig). The committed
# sdkconfig is the configuration: a regenerated one rewrites about 840 of its lines (turning TLS 1.3 off),
# and the build then stops at tls_engine.c's TLS 1.3 #error. Restore the committed sdkconfig instead.
# These pins only keep the esp-pqc options safe in such a file: IDF's default
# ESP_WIFI_MBEDTLS_TLS_CLIENT=y (with Wi-Fi Enterprise) compiles wpa_supplicant against the stock
# ssl_misc.h, which main/CMakeLists.txt refuses together with X25519MLKEM768.
CONFIG_ESP_WIFI_MBEDTLS_TLS_CLIENT=n
CONFIG_MBEDTLS_DYNAMIC_BUFFER=n
CONFIG_MBEDTLS_USE_BUNDLED_PQC=y
CONFIG_LIBOQS_ENABLED=y
CONFIG_LIBOQS_ENABLE_KEM_ML_KEM=y
CONFIG_LIBOQS_ENABLE_SIG_ML_DSA=n
CONFIG_MBEDTLS_SSL_TLS1_3_KEY_EXCHANGE_GROUP_X25519MLKEM768=y
