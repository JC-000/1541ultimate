+// One byte of a telnet command. The rest of the command can still be on the
+// wire when the IAC arrives, and a READ then returns no data (-1), so poll until
+// the byte comes, the connection closes (0) or 2 seconds pass. -1 = no byte.
+int telnet_nextbyte(void) {
+	clock_t until = clock() + 2 * CLOCKS_PER_SEC;
+	int count;
+
+	do {
+		count = uii_socketread(socketnr, 1);
+		if (count > 0) return uii_data[2];
+		if (count == 0) return -1;                     // closed: the main loop sees it on its next READ
+	} while (clock() < until);
+	return -1;
+}
